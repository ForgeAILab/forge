# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Local SQLite database created by `forge --seed`
forge.db
forge.db-shm
forge.db-wal

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

.DS_Store
forge.db*

.env
.env.*
*.pem
*.key
*.secret
credentials*
!crates/forge-daemon/src/credentials.rs

# Local test data directory (used with --data-dir ./test)
/test/
/design/

.claude/worktrees/
.playwright-mcp
.codex/
.pnpm-store/
test-results/

node_modules/

docs/spec/

# Canonical generated TypeScript bindings live under web/src/types/generated.
crates/api-types/bindings/ProjectHook*.ts
.codegraph/

# Editor/agent tool state
.cursor/
.omo/

# Local sibling override for coordinated Agent Runtime development.
/.cargo/
