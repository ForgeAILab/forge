  "configuration": [
    {
      "id": "review_retries",
      "label": "Review change cycles",
      "description": "Requested-change cycles allowed before the task requires explicit recovery.",
      "value_type": "integer",
      "min": 0,
      "default_value": 3,
      "binding": {
        "type": "gate_config",
        "state": "review",
        "field": "max_rejections"
      }
    },
    {
      "id": "worker_prompt_instructions",
      "label": "Worker instructions",
      "description": "Extra project instructions appended to worker task prompts.",
      "value_type": "text",
      "min": null,
      "default_value": "",
      "binding": {
        "type": "state_config",
        "state": "working",
        "path": [
          "prompt",
          "user_append"
        ]
      }
    },
    {
      "id": "merge_fix_prompt_instructions",
      "label": "Merge repair instructions",
      "description": "Extra project instructions appended during merge-conflict recovery.",
      "value_type": "text",
      "min": null,
      "default_value": "",
      "binding": {
        "type": "state_config",
        "state": "merge_failed",
        "path": [
          "prompt",
          "user_append"
        ]
      }
    }
