              "system_append": null
            }
          }
        }
      },
      "config": {
        "prompt": {
          "user_append": ""
        }
      }
    },
    {
      "name": "review",
      "kind": "gate",
      "column": "Review",
      "display_name": "Review",
      "canonical_phase": "review",
      "role": null,
      "hooks": {
