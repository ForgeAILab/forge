    "type": "object"
  },
  "skill.section": {
    "additionalProperties": false,
    "description": "Returns one server-owned Project operating-doctrine section by name. Read the matching section before the first work of that kind in a conversation and re-read it when unsure: research, documents, scope_change, tasks, milestones, release.",
