# Paste into the Environment tab of the Dokploy application and fill in.
# Dokploy stores these in an env file that Compose interpolates: keep every
# value free of `$`, `#`, quotes, spaces and backslashes.

# --- Required -------------------------------------------------------------

# The moving tag the pull-request check updates.
FORGE_DEMO_IMAGE=ghcr.io/<owner>/<repo>-demo:live

# Public URL of the demo, with scheme. Same value as the DEMO_URL repository
# variable and as the domain set in the Domains tab.
FORGE_PUBLIC_BASE_URL=https://<demo host name>

# First account created at every start: the instance's administrator.
DEMO_ADMIN_EMAIL=
# 8-128 characters from A-Z a-z 0-9 . _ ~ + = , -   (e.g. `openssl rand -hex 24`)
DEMO_ADMIN_PASSWORD=

# Second account, without administrator rights. The test suite signs in with
# this one.
DEMO_TEST_EMAIL=
# Same character rule as above.
DEMO_TEST_PASSWORD=

# --- Optional (defaults shown) --------------------------------------------

#DEMO_ADMIN_NAME=Demo Admin
#DEMO_TEST_NAME=Demo Tester

# Role of the test account in the seeded Demo project: owner, admin, member
# or viewer. Empty leaves the test account with an empty instance.
#DEMO_TEST_PROJECT_ROLE=member

# Seconds the entrypoint waits for Forge before it gives up.
#DEMO_SEED_TIMEOUT_SECONDS=180

# Size caps of the memory-backed filesystems (data, log files, temp), and
# container limits. The three sizes count against DEMO_FORGE_MEMORY.
#DEMO_DATA_SIZE=512m
#DEMO_LOG_SIZE=64m
#DEMO_TMP_SIZE=128m
#DEMO_FORGE_MEMORY=2g
#DEMO_FORGE_CPUS=2
#DEMO_FORGE_PIDS_LIMIT=512

# Log filter (RUST_LOG syntax). Unset keeps Forge's own default.
#DEMO_RUST_LOG=
